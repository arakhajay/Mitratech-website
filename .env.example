# Sanity CMS Configuration
# Get these values from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Write Token (for migration script only)
# Generate at: Sanity Dashboard → Settings → API → Tokens
# Required permission: Editor
SANITY_WRITE_TOKEN=

# Revalidation Secret (generate a random UUID)
# Used to secure the /api/revalidate webhook endpoint
SANITY_REVALIDATE_SECRET=
